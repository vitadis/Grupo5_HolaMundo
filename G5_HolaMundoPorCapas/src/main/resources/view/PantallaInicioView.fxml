            </GridPane>
            <GridPane prefHeight="614.0" prefWidth="640.0" styleClass="Tabla" GridPane.columnIndex="1" GridPane.hgrow="ALWAYS" GridPane.rowIndex="1" GridPane.vgrow="ALWAYS">
